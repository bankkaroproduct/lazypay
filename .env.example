# ─────────────────────────────────────────────────────────────────────
# LazyPay — environment variables
#
# Copy to .env.local for local dev (never commit .env.local).
# In production set the same keys in Vercel → Project Settings →
# Environment Variables, then redeploy.
# ─────────────────────────────────────────────────────────────────────

# ── Partner API (BankKaro) — REQUIRED ────────────────────────────────
# Server-only. Used for the partner token, the partner cards API
# (lazypay's own apply links), get-link and Journey Track.
PARTNER_API_KEY=your_lazypay_partner_api_key
PARTNER_TOKEN_URL=https://platform.bankkaro.com/partner/token
PARTNER_BASE_URL=https://platform.bankkaro.com/partner

# ── App ──────────────────────────────────────────────────────────────
# Canonical URL; also allowed as an origin by /api/token.
NEXT_PUBLIC_APP_URL=https://lazypay.bankkaro.com

# ── Brand ────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=LAZYPAY
NEXT_PUBLIC_BRAND_TAGLINE=Smart Payment Solutions for Everyone
NEXT_PUBLIC_BRAND_EMAIL=support@lazypay.com
NEXT_PUBLIC_BRAND_LOGO=/logo.svg
NEXT_PUBLIC_BRAND_FAVICON=/favicon.svg
NEXT_PUBLIC_HEADER_BG_COLOR=#FF1E7E

# Theme colours as HSL parts (pink primary, light-grey secondary).
# Alternatively set NEXT_PUBLIC_PRIMARY_COLOR / NEXT_PUBLIC_SECONDARY_COLOR as hex.
NEXT_PUBLIC_PRIMARY_HUE=330
NEXT_PUBLIC_PRIMARY_SAT=100%
NEXT_PUBLIC_PRIMARY_LIGHT=45%
NEXT_PUBLIC_SECONDARY_HUE=0
NEXT_PUBLIC_SECONDARY_SAT=0%
NEXT_PUBLIC_SECONDARY_LIGHT=96.1%

# ── Optional ─────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Extra dummy numbers to reject on the lead form, comma-separated.
NEXT_PUBLIC_BLOCKED_PHONES=
# Set to true to beacon apply clicks to /api/redirect-click.
NEXT_PUBLIC_ENABLE_REDIRECT_ANALYTICS=
# Overrides (defaults shown).
# JT_API_URL=https://bk-sbi-journey.bankkaro.com/JT/api
# PUBLIC_CARDS_URL=https://bk-prod-external.bankkaro.com/sp/api/cards
